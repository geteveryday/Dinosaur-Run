}

QPushButton#btnHelp:hover {
    color: #ffff00; /* 保持hover时的黄色文字效果 */
    background-color: #4477ff;
    border: 4px solid #3366dd;
}

QPushButton#btnHelp:pressed {
    color: #dddddd;
    background-color: #2255ee;
    border: 4px solid #1144dd;
    padding: 12px 30px 8px 30px; /* 保持按压时的位移效果 */
}</string>
