         </size>
        </property>
        <property name="styleSheet">
         <string notr="true">QPushButton#btnStart {
    /* 字体相关 */
    font-family: &quot;SimHei&quot;; /* 黑体，也可根据需求换其他像素风格字体 */
    font-size: 24px; /* 字体大小 */
    font-weight: bold; /* 字体加粗 */
    color: white; /* 字体颜色 */

    /* 按钮其他样式（可选，若需要和界面更协调） */
    background-color: #22cc22; /* 按钮背景色，与界面中绿色匹配 */
    border-radius: 20px; /* 圆角 */
    padding: 10px 30px; /* 内边距 */
    border: 4px solid #11aa11; /* 边框 */
}

/* 开始按钮悬浮状态字体样式（可选，若要改变悬浮时字体效果） */
QPushButton#btnStart:hover {
    color: #ffff00; /* 悬浮时字体变黄，可自行调整 */
    background-color: #33dd33; /* 悬浮时背景色变化 */
    border: 4px solid #22bb22; /* 悬浮时边框变化 */
}

/* 开始按钮按下状态字体样式（可选，若要改变点击时字体效果） */
QPushButton#btnStart:pressed {
    color: #dddddd; /* 按下时字体颜色变浅，可自行调整 */
    background-color: #11bb11; /* 按下时背景色变化 */
    border: 4px solid #00aa00; /* 按下时边框变化 */
    padding: 12px 30px 8px 30px; /* 点击时轻微位移，模拟按下效果 */
}</string>
        </property>
        <property name="text">
         <string>开始</string>
        </property>
       </widget>
