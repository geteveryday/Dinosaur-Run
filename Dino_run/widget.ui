        <property name="styleSheet">
         <string notr="true">QPushButton#btnSetting {
    font-family: &quot;SimHei&quot;;
    font-size: 24px;
    font-weight: bold;
    color: white;

    background-color: #2288ff; /* 蓝色背景，匹配界面色调 */
    border-radius: 20px;
    padding: 10px 30px;
    border: 4px solid #1177ee;
}

QPushButton#btnSetting:hover {
    color: #ffff00;
    background-color: #3399ff;
    border: 4px solid #2288ee;
}

QPushButton#btnSetting:pressed {
    color: #dddddd;
    background-color: #1177dd;
    border: 4px solid #0066dd;
    padding: 12px 30px 8px 30px;
}</string>
        </property>
